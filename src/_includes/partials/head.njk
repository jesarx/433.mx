<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} — {% endif %}{{ site.site_name }} Festival</title>
<meta name="description" content="4'33'' — Espacio para el sonido. Encuentro de músicas clásicas contemporáneas. {{ site.fechas }}, {{ site.lugar }}.">
<link rel="canonical" href="{{ site.site_url }}{{ page.url }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:title" content="{% if title %}{{ title }} — {% endif %}{{ site.site_name }} Festival">
<meta property="og:description" content="Encuentro de músicas clásicas contemporáneas. {{ site.fechas }}, {{ site.lugar }}.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.site_name }}.mx">
<meta property="og:locale" content="es_MX">
<meta property="og:url" content="{{ site.site_url }}{{ page.url }}">
<meta property="og:image" content="{{ site.site_url }}/images/og-cartel.jpg">
<meta name="twitter:card" content="summary_large_image">
{% if page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Festival",
  "name": "4'33'' — Espacio para el sonido",
  "description": "Encuentro de músicas clásicas contemporáneas: conciertos, estrenos de obras comisionadas, conferencias, conversatorios y clases de composición.",
  "startDate": "2026-08-04",
  "endDate": "2026-08-09",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "Pátzcuaro",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Pátzcuaro",
      "addressRegion": "Michoacán",
      "addressCountry": "MX"
    }
  },
  "image": ["{{ site.site_url }}/images/og-cartel.jpg"],
  "url": "{{ site.site_url }}/",
  "organizer": {
    "@type": "Organization",
    "name": "4'33'' — Espacio para el sonido",
    "url": "{{ site.site_url }}",
    "email": "{{ site.email }}"
  }
}
</script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/css/tailwind.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
